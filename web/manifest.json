{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "id": "/?source=pwa",
  "name": "Luqi AI — Limitless Telecoms",
  "short_name": "Luqi AI",
  "description": "World-class AI SaaS platform — Built by Limitless Telecoms. Chat, learn, collaborate, code, train, and secure. Africa-first.",
  "version": "24.4.0",
  "start_url": "/?mode=standalone",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#F7F9F4",
  "theme_color": "#2D7D46",
  "orientation": "any",
  "lang": "en-ZA",
  "dir": "ltr",
  "categories": [
    "productivity",
    "education",
    "utilities",
    "business"
  ],
  "icons": [
    {
      "src": "/web/icons/icon-48x48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web/icons/icon-72x72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web/icons/icon-96x96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web/icons/icon-128x128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web/icons/icon-144x144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web/icons/icon-152x152.png",
      "sizes": "152x152",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web/icons/icon-192x192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/web/icons/icon-384x384.png",
      "sizes": "384x384",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/web/icons/icon-512x512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "AI Chat",
      "short_name": "Chat",
      "description": "Start a new conversation with Luqi AI",
      "url": "/?action=chat#chat",
      "icons": [
        {
          "src": "/web/icons/shortcut-chat-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Scam Shield",
      "short_name": "Shield",
      "description": "Verify suspicious offers, messages, or links",
      "url": "/?action=scam_shield#shield",
      "icons": [
        {
          "src": "/web/icons/shortcut-shield-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Knowledge Academy",
      "short_name": "Academy",
      "description": "Access interactive training and learning modules",
      "url": "/#academy",
      "icons": [
        {
          "src": "/web/icons/shortcut-academy-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Digital Wellness",
      "short_name": "Wellness",
      "description": "Check digital health & usage metrics",
      "url": "/web/wellness.html",
      "icons": [
        {
          "src": "/web/icons/shortcut-wellness-96x96.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/api/v1/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "document",
          "accept": ["text/*", "application/json", "application/pdf", "image/*"]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/?action=file-open",
      "accept": {
        "text/plain": [".txt", ".md"],
        "application/json": [".json"],
        "text/csv": [".csv"],
        "text/x-python": [".py"]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+luqi",
      "url": "/?query=%s"
    }
  ],
  "screenshots": [
    {
      "src": "/web/screenshots/mobile-chat.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Luqi AI Chat and Verification Engine"
    },
    {
      "src": "/web/screenshots/desktop-dashboard.png",
      "sizes": "2560x1440",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Limitless Telecoms Luqi AI Platform Dashboard"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false
}
