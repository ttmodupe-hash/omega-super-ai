# ==============================================================================
# LUQI-AI CORE - ADVANCED PRODUCTION ENVIRONMENT CONFIGURATION
# Location on server: /opt/luqi-core/.env
# Security Note: NEVER commit populated .env files to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PLATFORM HOST & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
LUQI_ENV=production                     # Options: development, staging, production
PORT=8000
HOST=0.0.0.0
WORKERS_PER_CORE=2                      # Uvicorn worker multiplier for multiprocess concurrency
LOG_LEVEL=info                          # Options: debug, info, warning, error, critical
LOG_FORMAT=json                         # Structured JSON logging for ELK/Loki ingestion

# ------------------------------------------------------------------------------
# 2. SECURITY, AUTHENTICATION & HUMAN-IN-THE-LOOP (HITL) GATES
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
LUQI_ADMIN_SECRET=CHANGEME_generate_with_openssl_rand_hex_32
JWT_SECRET_KEY=CHANGEME_generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=["https://luqi.ai","https://app.luqi.ai"]

# ------------------------------------------------------------------------------
# 3. CORE AI BRAIN & ORCHESTRATION ENGINE APIS
# ------------------------------------------------------------------------------
# Primary Multimodal Providers
GEMINI_API_KEY=CHANGEME_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro

CLAUDE_API_KEY=CHANGEME_claude_api_key
CLAUDE_MODEL=claude-3-5-sonnet-20240620

# Moonshot AI (Kimi Engine Integration)
KIMI_API_KEY=CHANGEME_kimi_api_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3                      # Flagship reasoning engine (1M context)
KIMI_CODE_MODEL=kimi-k2.7-code          # High-volume code generation engine
KIMI_REASONING_EFFORT=high              # Options: low, medium, high, max

# ------------------------------------------------------------------------------
# 4. VOICE SYNTHESIS & CULTURALLY AUTHENTIC AUDIO ENGINE
# ------------------------------------------------------------------------------
HUME_API_KEY=CHANGEME_hume_api_key
HUME_CONFIG_ID=CHANGEME_hume_voice_config_id

XI_API_KEY=CHANGEME_elevenlabs_api_key
XI_DEFAULT_VOICE_ID=CHANGEME_elevenlabs_voice_id

# ------------------------------------------------------------------------------
# 5. DISTRIBUTED DATASTORAGE & VECTOR AGGREGATION
# ------------------------------------------------------------------------------
# Primary Relational DB (PostgreSQL + Asyncpg)
DATABASE_URL=postgresql+psycopg2://luqi_admin:CHANGEME_db_password@luqi-pg-prod.internal:5432/luqi_ai_db
ASYNC_DATABASE_URL=postgresql+asyncpg://luqi_admin:CHANGEME_db_password@luqi-pg-prod.internal:5432/luqi_ai_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# Distributed Caching & Task Broker (Redis)
REDIS_URL=redis://:CHANGEME_redis_password@luqi-redis-prod.internal:6379/0
CELERY_BROKER_URL=redis://:CHANGEME_redis_password@luqi-redis-prod.internal:6379/1

# Vector Database (Qdrant / PGVector / Pinecone)
VECTOR_DB_URL=https://luqi-vector-prod.internal:6333
VECTOR_DB_API_KEY=CHANGEME_vector_db_key

# ------------------------------------------------------------------------------
# 6. SYSTEM MONITORING, AUDITING & DRIFT ALERTS
# ------------------------------------------------------------------------------
GITHUB_TOKEN=ghp_CHANGEME_github_personal_access_token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/CHANGEME/WEBHOOK/URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/CHANGEME/WEBHOOK/URL
SENTRY_DSN=https://CHANGEME@sentry.io/project_id

# ------------------------------------------------------------------------------
# 7. DOCKER SANDBOX VIRTUALIZATION & CONTAINMENT BOUNDARIES
# ------------------------------------------------------------------------------
DOCKER_HOST=unix:///var/run/docker.sock
MAX_SANDBOX_CONTAINERS=500
SANDBOX_MEM_LIMIT=512m                  # Per-container memory isolation cap
SANDBOX_CPU_QUOTA=50000                 # Per-container CPU limit (0.5 CPU core)
SANDBOX_TIMEOUT_SECONDS=60              # Hard execution limit for untrusted code
