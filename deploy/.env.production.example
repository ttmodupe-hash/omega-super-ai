# ==============================================================================
# LUQI-AI CORE - PRODUCTION ENVIRONMENT CONFIGURATION
# Location on server: /opt/luqi-core/.env
# NEVER commit the real .env to git. This template shows the required keys only.
# ==============================================================================

# 1. Platform Host Configuration
LUQI_ENV=production
PORT=8000
HOST=0.0.0.0

# 2. Security & Human-in-the-Loop Gate
# CHANGE THIS VALUE BEFORE GOING LIVE - generate: openssl rand -hex 32
LUQI_ADMIN_SECRET=SovereignAfricaLuqiAI2026_SecureAdminGateKey!

# 3. Core AI Brain Orchestration APIs
GEMINI_API_KEY=AIzaSyYourHighCapacityGeminiModelKey_Here
CLAUDE_API_KEY=sk-ant-api03-YourClaudeSelfHealingAgentKey_Here

# 4. Culturally Authentic Voice Synthesis Providers
HUME_API_KEY=HumeVoiceIntelligenceInterfaceToken_Here
XI_API_KEY=ElevenLabsCustomVoiceClonedMandelaNode_Here
# Kimi engine: moonshot-v1-auto sunset 2026-08-31 - use kimi-k3 (default)
# High-volume codegen: KIMI_MODEL=kimi-k2.7-code
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=high

# 5. Distributed Storage (Production PostgreSQL)
# Format: postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE
# MySQL alternative: DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:3306/luqi_ai
DATABASE_URL=postgresql+psycopg2://luqi_admin:IroncladPassword2026!@luqi-db.cape-town.rds.amazonaws.com:5432/luqi_ai

# 5b. Context sync auditor + drift alerts (optional)
# GITHUB_TOKEN=ghp_...                 # required for /v1/sync/audit
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...   # optional drift alerts
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/... # optional drift alerts

# 6. Docker Sandbox Virtualization Boundaries
DOCKER_HOST=unix:///var/run/docker.sock
MAX_SANDBOX_CONTAINERS=500
