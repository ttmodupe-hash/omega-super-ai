# ==============================================================================
# LUQI-AI .env - MINIMAL ACTIVE SET (fill lines marked <--- in place, on the
# SERVER, via: nano /opt/luqi-ai/.env   or   ./deploy/inject_secrets.sh
# Never commit this file. Never paste real values into any chat - if a value
# was ever pasted in a chat, rotate it at the provider console first.
# Add the rest (Gemini/Claude/Paystack/etc.) only once these are ACTIVE.
# ==============================================================================

# --- TIER 1: required to boot usefully (fill these first) ---
LUQI_ADMIN_SECRET=                                    # <--- openssl rand -hex 32
KIMI_API_KEY=                                         # <--- platform.moonshot.ai (the brain we already have)
JWT_SECRET_SIGNING_KEY=                               # <--- openssl rand -hex 32

# --- TIER 2: persistence (fill when the DB node exists; API boots without it) ---
DATABASE_URL=postgresql+psycopg2://luqi:CHANGE_ME@HOST:5432/luqi_ai

# --- TIER 3: add later, only when wiring each feature live ---
# GEMINI_API_KEY=                                     # multipolar router, second provider
# CLAUDE_API_KEY=                                     # multipolar router, codegen chain
# XI_API_KEY=                                         # voice playback (/v1/voice/speak)
# PAYSTACK_SECRET_KEY=                                # payments (sk_live_ only in prod)
# AFRICAS_TALKING_API_KEY=                            # gate-lock SMS alerts
# ADMIN_PHONE_NUMBER=+27...                           # alert recipient
# BACKUP_ENCRYPTION_KEY=                              # base64 of 32 bytes, BEFORE first backup
# STATE_BACKEND=redis + REDIS_URL=                    # only for multi-worker
# DATABASE_URL_BACKUP=                                # only with a real replica
