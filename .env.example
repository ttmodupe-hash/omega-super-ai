# ==============================================================================
# LUQI AI CORE CONFIGURATION - PRODUCTION ENVIRONMENT
# ==============================================================================

# System Security Secrets
# Generated via: openssl rand -hex 32
# SECURITY LAW: real secrets live in Railway env vars ONLY — never commit them.
LUQI_ADMIN_SECRET=CHANGEME_generate_with_openssl_rand_hex_32
XI_API_KEY=__REQUIRED_ELEVENLABS_API_KEY__

# Kimi Engine & AI Model Orchestration
# Note: moonshot-v1-auto sunset 2026-08-31. Updated to kimi-k3 framework.
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=high

# Storage & Infrastructure Persistence
# PostgreSQL Database Connection
DATABASE_URL=postgresql+psycopg2://luqi_db_user:CHANGEME_DB_PASSWORD@localhost:5432/luqi_ai_prod

# Task Ledger & State Persistence (Multi-Worker Scalability)
# Switch from in-memory to Redis for multi-replica state persistence
STATE_BACKEND=redis
REDIS_URL=redis://:CHANGEME_REDIS_PASSWORD@localhost:6379/0

# LLM Spend Guard & Cost Controls
MONTHLY_TOKEN_BUDGET_USD=100
COST_HARD_STOP_PCT=100
COST_ALARM_SMS_PCT=80

# Cross-Origin Resource Sharing (CORS) Protection
# Explicit production endpoints - wildcards prohibited
LUQI_CORS_ORIGINS=https://luqi.limitlesstelecoms.co.za,https://admin.limitlesstelecoms.co.za

# Adaptive Nudge Daemon & Messaging Transport
LUQI_ADAPTIVE_NUDGES=1
LUQI_NUDGE_WEBHOOK_URL=https://api.limitlesstelecoms.co.za/v1/telecom/sms/nudge-gateway

# Stripe International Card Gateway & Wallet Top-Ups
STRIPE_SECRET_KEY=__REQUIRED_STRIPE_SECRET_KEY__
STRIPE_WEBHOOK_SECRET=__REQUIRED_STRIPE_WEBHOOK_SECRET__
STRIPE_PRICE_TABLE={"topup_100": {"amount_cents": 10000, "currency": "zar", "description": "Wallet top-up R100"}}
STRIPE_SUCCESS_URL=https://luqi.limitlesstelecoms.co.za/payments/success
STRIPE_CANCEL_URL=https://luqi.limitlesstelecoms.co.za/payments/cancel

# NOTE: the production pre-flight validator that was accidentally pasted here
# now lives at scripts/validate_production_env.py (run: python3 scripts/validate_production_env.py)