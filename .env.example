# REQUIRED before any real deployment - generate: openssl rand -hex 32
# (previous default value scrubbed 2026-09-18: a committed default admin key is
# a publicly known admin key)
LUQI_ADMIN_SECRET=CHANGEME_generate_with_openssl_rand_hex_32
XI_API_KEY=CHANGEME_elevenlabs_api_key
# Kimi engine: moonshot-v1-auto sunset 2026-08-31 - use kimi-k3 (default)
# High-volume codegen: KIMI_MODEL=kimi-k2.7-code
KIMI_MODEL=kimi-k3
KIMI_REASONING_EFFORT=high
DATABASE_URL=postgresql+psycopg2://luqi:luqi@localhost:5432/luqi_ai

# Stripe international card gateway (wallet top-ups). Leave unset to disable.
# Checkout amounts are server-side only (STRIPE_PRICE_TABLE) - never client pricing.
STRIPE_SECRET_KEY=CHANGEME_sk_live_or_sk_test
STRIPE_WEBHOOK_SECRET=CHANGEME_whsec_from_stripe_dashboard_webhook
# STRIPE_PRICE_TABLE={"topup_100": {"amount_cents": 10000, "currency": "zar", "description": "Wallet top-up R100"}}
# STRIPE_SUCCESS_URL=https://your-frontend.example/payments/success
# STRIPE_CANCEL_URL=https://your-frontend.example/payments/cancel
